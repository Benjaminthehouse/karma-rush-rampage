{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "karma-rush",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": { "entry": "splash.html", "height": "tall" },
      "game": { "entry": "game.html" }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "redis": true,
    "journeys": true,
    "realtime": true,
    "reddit": { "enable": true, "scope": "user", "asUser": ["SUBMIT_COMMENT", "SUBSCRIBE_TO_SUBREDDIT"] }
  },
  "menu": {
    "items": [
      {
        "label": "Karma Rush Rampage: post today's game",
        "description": "Creates today's Karma Rush Rampage post",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/on-app-install"
  },
  "scheduler": {
    "tasks": {
      "daily-post": { "endpoint": "/internal/cron/daily-post", "cron": "0 0 * * *" }
    }
  },
  "scripts": {
    "dev": "npm run build:watch",
    "build": "npm run build"
  }
}
